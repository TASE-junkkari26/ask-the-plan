# Backend only. Paste your Verda inference key after the equals sign.
VERDA_INFERENCE_KEY=

# Defaults for the supplied Junction Nemotron deployment; no edits needed.
VERDA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
VERDA_MODEL=nemotron-3.5-super-vl
VERDA_TIMEOUT_SECONDS=120
VERDA_MAX_RETRIES=2
VERDA_MAX_TOKENS=2048
VERDA_TEMPERATURE=0.2
# false/true send vLLM's chat_template_kwargs.enable_thinking; auto omits it.
VERDA_ENABLE_THINKING=false

# Image candidate provider, independent of IFC planning below.
# Switch to gemini to use Gemini Hydrogen with low thinking for images.
IMAGE_API_PROVIDER=nemotron
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TIMEOUT_SECONDS=120

# IFC planner: parsing, query execution and source evidence remain local.
# Nemotron uses VERDA_*; Gemini uses GEMINI_API_KEY/MODEL/TIMEOUT_SECONDS.
IFC_API_PROVIDER=nemotron
# Separate from the image provider's low thinking; low/medium/high/xhigh.
IFC_GEMINI_THINKING_LEVEL=high
# Combined thinking and final output budget per Gemini planning request.
IFC_GEMINI_MAX_OUTPUT_TOKENS=65536
IFC_API_MAX_TOKENS=6000
IFC_API_DEADLINE_SECONDS=180
# Hard ceilings: three planner requests and six source inspections per question.
IFC_API_MAX_MODEL_REQUESTS=3
IFC_API_MAX_INSPECTIONS=6

# Candidate API raster preparation. Default keeps model image bytes unchanged.
# overview sends a reduced whole-page image; off skips artifact preparation.
IMAGE_API_PREPROCESS_MODE=original
IMAGE_API_PREPROCESS_OVERVIEW_LONG_EDGE=1600
IMAGE_API_PREPROCESS_CACHE_ENTRIES=8
