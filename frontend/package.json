{
  "name": "ask-the-plan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/prepare-ifc-assets.mjs && vite --host 127.0.0.1",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "build": "node scripts/prepare-ifc-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/demo/engine.test.ts src/lib/viewport.test.ts src/lib/importDocument.test.ts src/lib/importSource.test.ts src/ifc/properties.test.ts src/lib/candidateApi.test.ts src/lib/candidateGeometry.test.ts src/ifc/conversion.test.ts src/ifc/stepFile.test.ts src/ifc/rendering.test.ts src/ifc/tasks.test.ts src/ifc/conversionError.test.ts src/ifc/geometryRecovery.test.ts src/ifc/evidence.test.ts src/ifc/answer.test.ts src/lib/ifcApi.test.ts",
    "prepare:ifc-assets": "node scripts/prepare-ifc-assets.mjs",
    "prepare:ifc-demo": "node --experimental-strip-types scripts/prepare-ifc-demo.mts"
  },
  "dependencies": {
    "@thatopen/components": "3.6.0",
    "@thatopen/components-front": "3.6.1",
    "@thatopen/fragments": "3.6.1",
    "camera-controls": "3.1.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.184.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
